# MongoDB Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/saasgrid?retryWrites=true&w=majority

# JWT Secret for User Authentication
JWT_SECRET=your_jwt_super_secret_key_here

# Admin Master Secret Passcode Key
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Google Analytics 4 Measurement ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google OAuth Client ID for Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP for Newsletter / Automated Emails
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_FROM_NAME=SaaTerra Platform

# Groq AI API Key (Llama 3.3 70B & 8B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
